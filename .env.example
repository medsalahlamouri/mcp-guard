# Copy to .env locally. Never commit .env or real credentials.

# Local web interface (set a unique, strong value)
MCPGUARD_MOT_DE_PASSE=

# Agent
MCPGUARD_MODELE=sonnet
MCPGUARD_MAX_TOURS=20

# Scheduled re-audit
MCPGUARD_REAUDIT_HEURE=8
MCPGUARD_REAUDIT_MINUTES=0
MCPGUARD_FUSEAU=Africa/Tunis

# Gmail SMTP (optional; use a Google App Password, never your account password)
SMTP_HOTE=smtp.gmail.com
SMTP_PORT=465
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
ALERTE_DESTINATAIRE=

# GitHub API (optional; use a fine-grained token with minimum required permissions)
GITHUB_TOKEN=

# Google Drive OAuth (optional)
# Download a Desktop OAuth client file locally as credentials.json.
# Run: python -m backend.autoriser_drive
# The generated token.json must remain local and must never be committed.
DRIVE_ACTIVE=1
DRIVE_CREDENTIALS=credentials.json
DRIVE_TOKEN=token.json
DRIVE_DOSSIER_RACINE=MCP-Guard

# Notifications
NOTIFICATION_CHAQUE_AUDIT=1
