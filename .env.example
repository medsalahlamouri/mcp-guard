# Copiez ce fichier en « .env » puis complétez les valeurs.
# Ne partagez jamais le fichier .env : il contient vos secrets (il est exclu par .gitignore).
# Description complète de chaque variable et valeurs par défaut : README.md, section « Configuration ».

# --- Authentification de l'interface web (obligatoire) ---
MCPGUARD_MOT_DE_PASSE=ChoisissezUnMotDePasseSolide

# --- Agent ---
# Modèle utilisé par l'agent : sonnet (recommandé, économe en quota) ou opus
MCPGUARD_MODELE=sonnet
# Nombre maximal de tours de l'agent par requête
MCPGUARD_MAX_TOURS=20

# --- Tâche planifiée (réaudit des serveurs approuvés) ---
# Mode normal : chaque jour à cette heure
MCPGUARD_REAUDIT_HEURE=8
# Mode démonstration : toutes les N minutes. 0 = mode normal (heure ci-dessus).
# Le code utilise 0 si la variable est absente ; cet exemple met 2 pour les démonstrations.
MCPGUARD_REAUDIT_MINUTES=2
# Fuseau horaire du planificateur
MCPGUARD_FUSEAU=Africa/Tunis

# --- Connecteur e-mail Gmail (facultatif) ---
# Nécessite la validation en deux étapes et un « mot de passe d'application » Google.
# Sans ces valeurs, les alertes sont enregistrées dans data/outbox/ (mode démonstration).
SMTP_HOTE=smtp.gmail.com
SMTP_PORT=465
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
# Destinataire par défaut ; l'adresse saisie dans l'onglet Préférences de l'interface est prioritaire.
ALERTE_DESTINATAIRE=

# --- Connecteur GitHub (facultatif, pour les dépôts privés ou éviter la limite de débit) ---
GITHUB_TOKEN=

# --- Archivage Google Drive des rapports (facultatif) ---
# OAuth2 « Application de bureau », scope drive.file uniquement.
# 1) Placez credentials.json (téléchargé depuis Google Cloud) à la racine du projet.
# 2) Lancez une fois : python -m backend.autoriser_drive   (crée token.json)
DRIVE_ACTIVE=1
# Chemins relatifs à la racine du projet (ou absolus)
DRIVE_CREDENTIALS=credentials.json
DRIVE_TOKEN=token.json
DRIVE_DOSSIER_RACINE=MCP-Guard

# --- Notification e-mail après CHAQUE audit (1 = oui, 0 = non) ---
NOTIFICATION_CHAQUE_AUDIT=1

# --- Base SQLite (facultatif) : chemin de la mémoire à long terme. Vide = data/mcp_guard.db ---
MCPGUARD_BASE=
