# --- Secrets : ne jamais partager ni archiver ---
.env
.env.*
!.env.example
# Google Drive (OAuth2) : identifiants client et jeton d'accès
credentials.json
credentials*.json
token.json
# Fichiers d'identifiants courants
*.pem
*.key

# --- Données locales générées par l'application ---
data/*.db
data/*.db-journal
data/outbox/
uploads/*
!uploads/.gitkeep

# --- Python, outils de test et d'analyse ---
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Éditeurs et système ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Réglages locaux de Claude Code et ancienne version de l'interface (non livrées) ---
.claude/settings.local.json
frontend/index.ancien.html
